{
  "name": "us-midterms-2026-data",
  "private": true,
  "type": "module",
  "description": "Data for the US midterms 2026 Datawrapper charts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sources": "node src/run.js sources",
    "base": "node src/run.js base",
    "update": "node src/run.js update",
    "watch": "node src/run.js update --every 60",
    "push": "node src/run.js update --push",
    "watch:push": "node src/run.js update --push --every 60",
    "offline": "node src/run.js update --offline"
  }
}
